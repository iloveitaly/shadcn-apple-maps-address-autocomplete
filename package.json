{
  "name": "shadcn-apple-maps-address-autocomplete",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "shadcn address autocomplete for the Apple Maps Server API.",
  "homepage": "https://iloveitaly.github.io/shadcn-apple-maps-address-autocomplete/",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "shadcn-registry",
    "apple-maps",
    "address-autocomplete"
  ],
  "scripts": {
    "dev": "pnpm registry:build && vite",
    "build": "pnpm registry:validate && pnpm registry:build && pnpm typecheck && vite build",
    "preview": "vite preview",
    "start": "pnpm preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:validate": "shadcn registry validate",
    "test": "playwright test",
    "test:registry": "node scripts/test-registry.mjs",
    "upgrade:shadcn": "node scripts/upgrade-shadcn.mjs",
    "upgrade:packages": "pnpm dlx npm-check-updates --interactive --format group"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "prettier": {
    "semi": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./app/globals.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iloveitaly/shadcn-apple-maps-address-autocomplete.git"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=12.15.0 <13"
  }
}
