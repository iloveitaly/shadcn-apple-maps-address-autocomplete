# Optional overrides; package.json supplies the default repository and site URLs.
# VITE_SITE_URL=https://your-username.github.io/your-registry/
# VITE_BASE_PATH=/your-registry/
# VITE_GITHUB_REPO_URL=https://github.com/your-username/your-registry
# VITE_GITHUB_BRANCH=main
# Short-lived Apple Maps Server API access token (GET /v1/token). Enables live
# suggestions in the demo. Omit it to replay captured responses.
# VITE_APPLE_MAPS_TOKEN=
